# Server
NODE_ENV=development
PORT=3001
API_PREFIX=/api

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=alfakhir_school
DB_USER=alfakhir
DB_PASSWORD=your_secure_password_here
DB_SSL=false

# JWT
JWT_SECRET=your_very_long_jwt_secret_key_change_this_in_production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_refresh_token_secret_change_this
JWT_REFRESH_EXPIRES_IN=7d

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@alfakhirschool.sch.id
SMTP_PASS=your_app_password

# Frontend URLs (CORS)
FRONTEND_GURU_URL=https://guru.alfakhirschool.id
FRONTEND_ADMIN_URL=https://admin.alfakhirschool.id

# Redis
REDIS_URL=redis://localhost:6379

# Logging
LOG_LEVEL=info
LOG_DIR=./logs

# Payment Gateway VA prefix (untuk generate nomor VA siswa)
BCA_VA_PREFIX=12345
MANDIRI_VA_PREFIX=12345678

# Webhook security token — harus diset di BCA/Mandiri callback config
WEBHOOK_CALLBACK_TOKEN=ganti_dengan_token_rahasia

# WhatsApp (WAHA self-hosted)
WAHA_URL=http://localhost:3000
WAHA_SESSION=default
WAHA_API_KEY=
# Fonnte fallback (opsional)
FONNTE_TOKEN=

# Absensi gerbang — generate: openssl rand -hex 32
GATE_SECRET=ganti_dengan_secret_panjang
# Set ini untuk aktifkan HMAC signature check di ESP32 RFID scanner (opsional, butuh firmware update)
RFID_HMAC_SECRET=

# AI / LLM
GEMINI_API_KEY=
GROQ_API_KEY=

# Observasi PPDB (external API)
OBSERVASI_API_URL=
OBSERVASI_API_KEY=

# n8n webhook notifications
N8N_WEBHOOK_URL=
N8N_WEBHOOK_GURU=
N8N_WEBHOOK_SISWA=

# Cloudflare Tunnel (opsional, untuk dev)
CLOUDFLARE_TUNNEL_TOKEN=
