# Server
NODE_ENV=development
PORT=3001
API_PREFIX=/api

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=alfakhir_school
DB_USER=alfakhir
DB_PASSWORD=your_secure_password_here
DB_SSL=false

# JWT
JWT_SECRET=your_very_long_jwt_secret_key_change_this_in_production
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=your_refresh_token_secret_change_this
JWT_REFRESH_EXPIRES_IN=7d

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@alfakhirschool.id
SMTP_PASS=your_app_password
EMAIL_FROM="Al Fakhir School <noreply@alfakhirschool.id>"

# Firebase FCM
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_PRIVATE_KEY=your_firebase_private_key
FIREBASE_CLIENT_EMAIL=your_firebase_client_email

# File Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# MinIO / S3
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=alfakhir-files

# BCA Payment Gateway
BCA_CLIENT_ID=your_bca_client_id
BCA_CLIENT_SECRET=your_bca_client_secret
BCA_API_KEY=your_bca_api_key
BCA_VA_PREFIX=12345
BCA_BASE_URL=https://devapi.klikbca.com

# Mandiri Payment Gateway
MANDIRI_CLIENT_ID=your_mandiri_client_id
MANDIRI_CLIENT_SECRET=your_mandiri_client_secret
MANDIRI_VA_PREFIX=12345678

# Frontend URLs (CORS)
FRONTEND_GURU_URL=https://guru.alfakhirschool.id
FRONTEND_ADMIN_URL=https://admin.alfakhirschool.id

# Redis
REDIS_URL=redis://localhost:6379

# Logging
LOG_LEVEL=info
LOG_DIR=./logs
